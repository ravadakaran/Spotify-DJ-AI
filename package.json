{
  "name": "ai-dj-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "lint": "eslint .",
    "format": "prettier --write client/src server/src server/tests scripts *.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "npm test -- --testPathPatterns=integration",
    "db:migrate": "node --env-file-if-exists=.env server/src/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env server/src/cli.js seed",
    "admin:create": "node --env-file-if-exists=.env server/src/cli.js admin",
    "setup": "node scripts/setup.js",
    "dev:local": "node scripts/local.js",
    "test:e2e": "playwright test",
    "library:import": "node scripts/library.js",
    "recommendations:evaluate": "node scripts/evaluate-recommendations.js",
    "password:calibrate": "node scripts/calibrate-passwords.js",
    "admin:create:local": "node --env-file-if-exists=.env server/src/cli.js admin --local",
    "benchmark": "node scripts/benchmark.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "security:scan": "node scripts/scan-secrets.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
