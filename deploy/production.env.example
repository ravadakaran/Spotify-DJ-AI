# Copy to /etc/ai-dj/environment on the VM with owner-only permissions.
# These placeholders are not deployable secrets or confirmed infrastructure.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://YOUR_PRIVATE_APP_HOST
COOKIE_SECURE=true
TRUST_LOOPBACK_PROXY=true
MONGODB_URI=mongodb://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:27017/ai_dj?authSource=ai_dj&replicaSet=rs0&directConnection=true
JWT_SIGNING_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_48_CHARACTERS
JWT_ISSUER=ai-dj-private
JWT_AUDIENCE=ai-dj-client
ASSET_ROOT=/var/lib/ai-dj/assets
AI_METADATA_APPROVED=false
OLLAMA_MODEL=
